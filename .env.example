# AEGIS Environment Configuration
# Graph Backend: 'networkx' (default, zero-external dependency) or 'neo4j'
GRAPH_BACKEND=networkx

# Neo4j Settings (only needed if GRAPH_BACKEND=neo4j)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=aegis_password

# LLM Configuration (LiteLLM abstraction)
# Supported providers: gemini, groq, ollama
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=gemini/gemini-1.5-flash

# Server Configuration
PORT=8000
HOST=0.0.0.0
