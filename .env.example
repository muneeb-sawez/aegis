# AEGIS Environment Configuration

# Graph Backend: 'networkx' (default, zero-external dependency) or 'neo4j'
GRAPH_BACKEND=networkx

# Neo4j Settings (NEO4J_PASSWORD is required when GRAPH_BACKEND=neo4j; no default password)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# Security & Administration (optional token protecting /api/reset)
ADMIN_SHARED_SECRET=

# LLM Configuration (LiteLLM abstraction)
# Supported providers: gemini, groq, ollama
LLM_PROVIDER=gemini
LLM_MODEL=gemini/gemini-1.5-flash
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OLLAMA_BASE_URL=http://localhost:11434

# Ingestion Settings
GITHUB_TOKEN=your_github_token_here

# Health Monitoring & Anomaly Detection Rules
BASELINE_WINDOW=5
LATENCY_MULTIPLIER=3.0
CONSECUTIVE_FAILURES=2
ERROR_RATE_THRESHOLD=0.5
COOLDOWN_SECONDS=60.0
MONITOR_INTERVAL_SEC=3.0
MONITOR_TIMEOUT_SEC=2.0

# Server Configuration
PORT=8000
HOST=0.0.0.0

